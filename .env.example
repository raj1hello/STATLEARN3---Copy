NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/statlearn2

SESSION_SECRET=super-secret-session-key-change-in-production-at-least-32-chars

ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_PROVIDER_BASE_URL=https://cc.api-anthropic.help
AI_PROVIDER_MODEL=claude-sonnet-5

MAX_UPLOAD_SIZE_MB=10

IGOT_MODE=mock

# ElevenLabs TTS (all optional; app runs without them)
# Add as many keys as you like — the server pool round-robins across them and
# auto-rotates on rate-limit/auth failures. Keys never leave the server.
ELEVENLABS_API_KEY_1=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=
# Optional voice/model overrides (defaults: Rachel voice, eleven_multilingual_v2)
ELEVENLABS_VOICE_ID=EXAVITQu4vrwxnBUxP9w
ELEVENLABS_MODEL=eleven_multilingual_v2
